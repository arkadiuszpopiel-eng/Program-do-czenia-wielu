{
  "name": "alfa-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "check": "pnpm -r --if-present check",
    "lint": "eslint . && node scripts/check-svelte5.mjs && node scripts/check-css.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "storybook": "pnpm --filter @alfa/ui-kit storybook",
    "build-storybook": "pnpm --filter @alfa/ui-kit build-storybook",
    "pre-commit": "bash scripts/pre-commit.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
