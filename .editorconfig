root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Windows PowerShell 5.1 czyta skrypty bez BOM jako ANSI — polskie znaki muszą mieć BOM.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
