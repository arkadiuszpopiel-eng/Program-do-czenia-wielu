{
  "name": "@alfa/ui-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Tokeny designu, komponenty Svelte 5 i Storybook Alfy (PLAN.md §14.3).",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tokens.json": "./src/tokens/tokens.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/check-contrast.mjs > /dev/null",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.49.0",
    "bits-ui": "2.19.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.9",
    "@storybook/svelte-vite": "9.1.9",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "storybook": "9.1.9",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
