{
  "version": 1,
  "description": "Scenariusze migracji schematów (ACCEPTANCE F7-08): paczki .alfa (manifest, sesje, tury), dokumenty pamięci i bazy SQLite (sesje, pamięć, indeks). Status: szkic — wymaga akceptacji człowieka.",
  "scenarios": [
    {
      "id": "m-01-paczka-v0",
      "entity": "alfa.package",
      "from": "0",
      "to": "1.0.0",
      "title": "Paczka v0 (szkic sprzed SPEC v1): manifest, nagłówek i tury v0 → v1",
      "input": {"package": "fixtures/alfa-v0", "workdir_root": "{SESJE}"},
      "expected": {
        "outcome": "ok",
        "schema_version": "1.0.0",
        "kind": "export",
        "keys": ["config.common", "sessions"],
        "upcast": [
          {
            "entity": "manifest",
            "from": "0",
            "to": "1.0.0",
            "count": 1
          },
          {"entity": "session", "from": "0", "to": "1", "count": 1},
          {"entity": "turn", "from": "0", "to": "1", "count": 8}
        ],
        "files_intact": true,
        "sessions": {
          "s-stara": {
            "title": "Stara rozmowa o wakacjach",
            "workdir": "{SESJE}/s-stara",
            "privacy": "normal",
            "active_leaf": 8,
            "draft": null,
            "turns": [
              {
                "id": 1,
                "parent": null,
                "branch": 1,
                "role": "user",
                "author": {"kind": "user"}
              },
              {
                "id": 2,
                "parent": 1,
                "branch": 1,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "beta"}
              },
              {
                "id": 3,
                "parent": 1,
                "branch": 2,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "alfa"}
              },
              {
                "id": 4,
                "parent": 3,
                "branch": 2,
                "role": "user",
                "author": {"kind": "user"}
              },
              {
                "id": 5,
                "parent": 4,
                "branch": 2,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "gama"}
              },
              {
                "id": 6,
                "parent": 2,
                "branch": 1,
                "role": "user",
                "author": {"kind": "user"}
              },
              {
                "id": 7,
                "parent": 6,
                "branch": 1,
                "role": "tool",
                "author": {"kind": "tool", "name": "narzędzie"}
              },
              {
                "id": 8,
                "parent": 7,
                "branch": 1,
                "role": "system",
                "author": {"kind": "system"}
              }
            ],
            "roundtrip_equal": true
          }
        }
      },
      "covered_by": [
        "transfer-contract/src/migrate_tests.rs::v0_session_gets_branches_and_authors",
        "transfer-contract/src/migrate_tests.rs::v0_manifest_is_upcast_and_valid"
      ],
      "notes": "Tura 3 bez pola `v` = v0; autor domyślny `alfa`; rola `tool` → autor „narzędzie”; gałęzie liczone regułami TreeCursor; ponowny eksport zapisuje rekordy v1."
    },
    {
      "id": "m-02-paczka-v1-f1",
      "entity": "alfa.package",
      "from": "1.0.0",
      "to": "1.0.0",
      "title": "Eksport F1 (schemat 1.0.0) importuje się bez migracji i bez strat",
      "input": {"package": "fixtures/alfa-v1", "workdir_root": "{SESJE}"},
      "expected": {
        "outcome": "ok",
        "schema_version": "1.0.0",
        "kind": "export",
        "keys": ["config.common", "sessions"],
        "upcast": [],
        "files_intact": true,
        "sessions": {
          "s-f1": {
            "title": "Plan wyjazdu do Torunia",
            "workdir": "{SESJE}/s-f1",
            "privacy": "normal",
            "active_leaf": 5,
            "draft": "A gdzie zjeść obiad?",
            "turns": [
              {
                "id": 1,
                "parent": null,
                "branch": 1,
                "role": "user",
                "author": {"kind": "user"}
              },
              {
                "id": 2,
                "parent": 1,
                "branch": 1,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "alfa"},
