    {
      "id": "m-06-manifest-starszy-major",
      "entity": "alfa.manifest",
      "from": "0.9.0",
      "to": "—",
      "title": "Manifest ze `schema_version` 0.x (starsze major bez upcastera) — czytelna odmowa „za stara”, nie „nowsza”",
      "input": {
        "manifest_from": "fixtures/alfa-v1/manifest.alfa.json",
        "set": {"schema_version": "0.9.0"}
      },
      "expected": {
        "outcome": "error",
