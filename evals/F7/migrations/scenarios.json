              {
                "id": 3,
                "parent": 1,
                "branch": 2,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "beta"},
                "hidden": true
              },
              {
                "id": 4,
                "parent": 2,
                "branch": 1,
                "role": "user",
                "author": {"kind": "user"}
              },
              {
                "id": 5,
                "parent": 4,
                "branch": 1,
                "role": "assistant",
                "author": {"kind": "agent", "agent": "alfa"}
              }
            ],
            "roundtrip_equal": true,
            "turns_bytes_identical": true
          }
        }
      },
      "covered_by": ["transfer-impl/tests/contract.rs", "app-core/tests/transfer.rs"],
      "notes": "Wymóg ACCEPTANCE F7-08 „wszystkie wersje od F1”: każda kolejna wersja schematu dokłada tu paczkę `alfa-v<N>`."
    },
    {
      "id": "m-03-tury-mieszane",
      "entity": "alfa.turns",
      "from": "0+1",
      "to": "1",
      "title": "Plik tur mieszający rekordy v0 i v1",
      "input": {
        "turns_inline": "{\"v\":0,\"id\":1,\"parent\":null,\"role\":\"user\",\"text\":\"Cześć\",\"ts\":\"2026-05-01T10:00:00Z\"}\n{\"v\":1,\"id\":2,\"parent\":1,\"branch\":1,\"role\":\"assistant\",\"author\":{\"kind\":\"agent\",\"agent\":\"alfa\"},\"content\":{\"text\":\"Witaj!\",\"blocks\":[]},\"usage\":null,\"created_at\":\"2026-05-01T10:00:02Z\",\"heard_prefix\":null,\"hidden\":false}\n{\"v\":0,\"id\":3,\"parent\":1,\"role\":\"assistant\",\"text\":\"Dzień dobry!\",\"ts\":\"2026-05-01T10:00:09Z\",\"agent\":\"delta\"}\n"
      },
      "expected": {
        "outcome": "ok",
        "upcast": [{"entity": "turn", "from": "0", "to": "1", "count": 2}],
        "turns": [
          {"id": 1, "branch": 1, "author": {"kind": "user"}},
          {
            "id": 2,
            "branch": 1,
            "author": {"kind": "agent", "agent": "alfa"}
          },
          {
            "id": 3,
            "branch": 2,
            "author": {"kind": "agent", "agent": "delta"}
          }
        ]
      },
      "covered_by": ["transfer-contract/src/migrate_tests.rs::v0_session_gets_branches_and_authors"]
    },
