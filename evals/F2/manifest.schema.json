  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pozycja manifestu.",
  "properties": {
    "audio": {
      "description": "Plik WAV względem katalogu korpusu (`16k/<maszyna>/<data>/t<NN>-….wav`).",
      "type": "string"
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandKind"
        },
        {
          "type": "null"
        }
      ],
      "description": "Komenda oczekiwana (typ 7)."
    },
    "conditions": {
      "$ref": "#/$defs/Conditions",
      "description": "Warunki."
    },
    "heard_words": {
      "description": "Prawdziwa liczba usłyszanych słów przed przerwaniem (typ 8, z odsłuchu/loopbacku).",
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "id": {
      "description": "Identyfikator (unikalny, `[a-z0-9._-]`).",
      "type": "string"
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterruptIntent"
        },
        {
          "type": "null"
        }
      ],
      "description": "Klasa intencji przerwania (typ 8)."
    },
    "kind": {
      "$ref": "#/$defs/ItemKind",
      "description": "Rodzaj nagrania."
    },
    "note": {
      "description": "Uwagi (co szumiało, odległość…).",
      "type": [
        "string",
        "null"
      ]
    },
    "onset_ms": {
      "description": "Początek słowa komendy w pliku (ms) — punkt odniesienia reakcji < 300 ms.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "segment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Segment"
        },
        {
          "type": "null"
        }
      ],
      "description": "Fragment pliku."
    },
    "split": {
      "$ref": "#/$defs/Split",
      "description": "Podział."
    },
    "synth": {
      "anyOf": [
        {
          "$ref": "#/$defs/SynthSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Przepis próbki syntetycznej."
    },
    "transcript": {
      "description": "Transkrypcja referencyjna (liczby słownie, jak wypowiedziane; wtrącenia EN w oryginale).",
      "type": [
        "string",
        "null"
      ]
    },
    "tts": {
      "anyOf": [
        {
          "$ref": "#/$defs/TtsContext"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wypowiedź agentki w tle (typy 8–9)."
    }
  },
  "required": [
    "id",
    "audio",
    "kind",
    "split",
    "conditions"
  ],
  "title": "ManifestEntry",
  "type": "object"
}
