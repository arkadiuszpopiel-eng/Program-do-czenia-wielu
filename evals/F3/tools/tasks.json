{
  "version": 1,
  "description": "Eval narzędzi F3 (fs/shell) dla agentki z narzędziami: polecenie, stan początkowy katalogu roboczego, oczekiwany stan końcowy. Zadania z `ci_script` przechodzi CI na skryptowanej atrapie modelu; pełny pomiar — model lokalny (llama.cpp) na maszynie użytkownika. Argumenty `ci_script` tylko ASCII.",
  "tasks": [
    {
      "id": "fs-01-write-number",
      "kind": "fs",
      "goal": "Utwórz w katalogu roboczym plik wynik.txt zawierający wyłącznie liczbę 42.",
      "expect": {
        "files": {
          "wynik.txt": {
            "equals": "42"
          }
        }
      },
      "ci_script": [
        {
          "tool": "fs_write",
          "args": {
            "path": "wynik.txt",
            "content": "42"
          }
        }
      ],
      "ci_answer": "Utworzyłam plik wynik.txt z liczbą 42."
    },
    {
      "id": "fs-02-move-to-archive",
      "kind": "fs",
      "goal": "Przenieś plik raport-2025.txt do katalogu archiwum.",
      "setup": {
        "files": {
          "raport-2025.txt": "Raport roczny 2025\n"
        },
        "dirs": [
          "archiwum"
        ]
      },
      "expect": {
        "files": {
          "archiwum/raport-2025.txt": {
            "equals": "Raport roczny 2025"
          }
        },
        "absent": [
          "raport-2025.txt"
        ]
      },
      "ci_script": [
        {
          "tool": "fs_move",
          "args": {
            "from": "raport-2025.txt",
            "to": "archiwum/raport-2025.txt"
          }
        }
      ],
      "ci_answer": "Przeniosłam raport do katalogu archiwum."
    },
    {
      "id": "fs-03-read-and-answer",
      "kind": "fs",
      "goal": "Odczytaj plik config.ini i podaj, na jakim porcie działa aplikacja.",
      "setup": {
        "files": {
          "config.ini": "[app]\nport=8080\nhost=localhost\n"
        }
      },
      "expect": {
        "unchanged": [
          "config.ini"
        ],
        "answer_contains": [
          "8080"
        ]
      },
      "ci_script": [
        {
          "tool": "fs_read",
          "args": {
            "path": "config.ini"
          }
        }
      ],
      "ci_answer": "Aplikacja działa na porcie 8080."
    },
    {
      "id": "fs-04-append-line",
      "kind": "fs",
      "goal": "Dopisz na końcu pliku dziennik.txt linię „2026-10-01: koniec”, nie zmieniając istniejącej treści.",
      "setup": {
        "files": {
          "dziennik.txt": "2026-09-30: start\n"
        }
      },
      "expect": {
        "files": {
          "dziennik.txt": {
            "contains": [
              "2026-09-30: start",
              "2026-10-01: koniec"
            ]
          }
        }
      }
    },
    {
      "id": "fs-05-rename",
      "kind": "fs",
      "goal": "Zmień nazwę pliku szkic.md na plan.md.",
      "setup": {
        "files": {
          "szkic.md": "# Plan\n"
        }
      },
      "expect": {
        "files": {
          "plan.md": {
            "equals": "# Plan"
          }
        },
        "absent": [
          "szkic.md"
        ]
      }
    },
    {
      "id": "fs-06-copy-backup",
      "kind": "fs",
      "goal": "Zrób kopię zapasową pliku dane.csv jako dane.csv.bak w tym samym katalogu.",
      "setup": {
        "files": {
          "dane.csv": "a,b\n1,2\n"
        }
      },
      "expect": {
        "files": {
          "dane.csv.bak": {
            "equals": "a,b\n1,2"
          }
        },
        "unchanged": [
          "dane.csv"
        ]
      }
    },
    {
      "id": "fs-07-mkdir-structure",
      "kind": "fs",
      "goal": "Utwórz w katalogu roboczym katalogi src, tests i docs.",
      "expect": {
        "dirs": [
          "src",
          "tests",
          "docs"
        ]
      }
    },
    {
      "id": "fs-08-sort-by-type",
      "kind": "fs",
      "goal": "Uporządkuj pliki: dokumenty PDF przenieś do katalogu Dokumenty, obrazy (jpg, png) do katalogu Obrazy; pliki tekstowe zostaw na miejscu.",
      "setup": {
        "files": {
          "a.pdf": "%PDF a",
          "b.pdf": "%PDF b",
          "c.jpg": "jpg",
          "d.png": "png",
          "e.txt": "notatka"
        }
      },
      "expect": {
        "files": {
          "Dokumenty/a.pdf": {},
          "Dokumenty/b.pdf": {},
          "Obrazy/c.jpg": {},
          "Obrazy/d.png": {}
        },
        "absent": [
          "a.pdf",
          "b.pdf",
          "c.jpg",
          "d.png"
        ],
        "unchanged": [
          "e.txt"
        ]
      }
    },
    {
      "id": "fs-09-find-by-content",
      "kind": "fs",
      "goal": "Znajdź w katalogu notatki plik, w którym zapisano hasło do wifi, i podaj jego nazwę. Niczego nie zmieniaj.",
      "setup": {
        "files": {
          "notatki/x.txt": "nic ciekawego\n",
          "notatki/y.txt": "hasło do wifi: zielony-kot\n",
          "notatki/z.txt": "lista zakupów\n"
        }
      },
      "expect": {
        "unchanged": [
          "notatki/x.txt",
          "notatki/y.txt",
          "notatki/z.txt"
        ],
        "answer_contains": [
          "y.txt"
        ]
      }
    },
    {
      "id": "fs-10-count-lines",
      "kind": "fs",
      "goal": "Ile niepustych linii ma plik lista.txt? Podaj liczbę w odpowiedzi.",
      "setup": {
        "files": {
          "lista.txt": "jabłka\ngruszki\nśliwki\nmleko\nchleb\nmasło\nser\n"
        }
      },
      "expect": {
        "unchanged": [
          "lista.txt"
        ],
        "answer_contains": [
          "7"
        ]
      }
    },
    {
      "id": "fs-11-replace-name",
      "kind": "fs",
      "goal": "W pliku umowa.txt zamień każde wystąpienie nazwiska Kowalski na Wiśniewski; resztę treści zostaw bez zmian.",
      "setup": {
        "files": {
          "umowa.txt": "Strona A: Kowalski\nStrona B: Nowak\nPodpis: Kowalski\n"
        }
      },
      "expect": {
        "files": {
          "umowa.txt": {
            "contains": [
              "Strona A: Wiśniewski",
              "Strona B: Nowak",
              "Podpis: Wiśniewski"
            ],
            "not_contains": [
              "Kowalski"
            ]
          }
        }
      }
    },
    {
      "id": "fs-12-merge-files",
      "kind": "fs",
      "goal": "Połącz pliki part1.txt i part2.txt (w tej kolejności) w nowy plik calosc.txt; oryginałów nie zmieniaj.",
      "setup": {
        "files": {
          "part1.txt": "Rozdział 1\n",
          "part2.txt": "Rozdział 2\n"
        }
      },
      "expect": {
        "files": {
          "calosc.txt": {
            "contains": [
              "Rozdział 1",
              "Rozdział 2"
            ]
          }
        },
        "unchanged": [
          "part1.txt",
          "part2.txt"
        ]
      }
    },
    {
      "id": "fs-13-json-edit",
      "kind": "fs",
      "goal": "W pliku ustawienia.json zmień motyw na „ciemny”, zachowując pozostałe ustawienia i poprawny JSON.",
      "setup": {
        "files": {
          "ustawienia.json": "{\n  \"motyw\": \"jasny\",\n  \"jezyk\": \"pl\"\n}\n"
        }
      },
      "expect": {
        "files": {
          "ustawienia.json": {
            "contains": [
              "\"ciemny\"",
              "\"jezyk\"",
              "\"pl\""
            ],
            "not_contains": [
              "jasny"
            ]
          }
        }
      }
    },
    {
      "id": "fs-14-list-to-file",
      "kind": "fs",
      "goal": "Zapisz do pliku spis.txt nazwy wszystkich plików z katalogu projekt, każdą w osobnej linii.",
      "setup": {
        "files": {
          "projekt/main.rs": "fn main() {}\n",
          "projekt/lib.rs": "\n",
          "projekt/README.md": "# Projekt\n",
          "projekt/Cargo.toml": "[package]\n"
        }
      },
      "expect": {
        "files": {
          "spis.txt": {
            "contains": [
              "main.rs",
              "lib.rs",
              "README.md",
              "Cargo.toml"
            ]
          }
        }
      }
    },
    {
      "id": "fs-15-no-overwrite",
      "kind": "fs",
      "goal": "Utwórz plik wazne.txt z treścią „nowa treść”. Jeśli taki plik już istnieje, nie nadpisuj go, tylko utwórz wazne-2.txt.",
      "setup": {
        "files": {
          "wazne.txt": "Nie zmieniać\n"
        }
      },
      "expect": {
        "files": {
          "wazne-2.txt": {
            "contains": [
              "nowa treść"
            ]
          }
        },
        "unchanged": [
          "wazne.txt"
        ]
      }
    },
    {
      "id": "fs-16-move-invoices",
      "kind": "fs",
      "goal": "Przenieś wszystkie faktury z katalogu Pobrane do katalogu Finanse/Faktury (utwórz go, jeśli trzeba). Inne pliki zostaw.",
      "setup": {
        "files": {
          "Pobrane/faktura-01.pdf": "%PDF 1",
          "Pobrane/faktura-02.pdf": "%PDF 2",
          "Pobrane/zdjecie.jpg": "jpg"
        }
      },
      "expect": {
        "files": {
          "Finanse/Faktury/faktura-01.pdf": {},
          "Finanse/Faktury/faktura-02.pdf": {}
        },
        "absent": [
          "Pobrane/faktura-01.pdf",
          "Pobrane/faktura-02.pdf"
        ],
        "unchanged": [
          "Pobrane/zdjecie.jpg"
        ]
      }
    },
    {
      "id": "fs-17-csv-sum",
      "kind": "fs",
      "goal": "Policz sumę kwot w pliku wydatki.csv i zapisz ją do pliku suma.txt (sama liczba).",
      "setup": {
        "files": {
          "wydatki.csv": "kategoria,kwota\njedzenie,120\ntransport,45\nrozrywka,35\n"
        }
      },
      "expect": {
        "files": {
          "suma.txt": {
            "equals": "200"
          }
        },
        "unchanged": [
          "wydatki.csv"
        ]
      }
    },
    {
      "id": "fs-18-toc",
      "kind": "fs",
      "goal": "Utwórz plik spis-tresci.md z listą nagłówków drugiego poziomu (##) z pliku dokument.md.",
      "setup": {
        "files": {
          "dokument.md": "# Wstęp\ntekst\n## Cel\ntekst\n## Zakres\ntekst\n"
        }
      },
      "expect": {
        "files": {
          "spis-tresci.md": {
            "contains": [
              "Cel",
              "Zakres"
            ],
            "not_contains": [
              "Wstęp"
            ]
          }
        },
        "unchanged": [
          "dokument.md"
        ]
      }
    },
    {
      "id": "fs-19-file-size",
      "kind": "fs",
      "goal": "Sprawdź rozmiar pliku duzy.txt w bajtach i podaj go w odpowiedzi.",
      "setup": {
        "files": {
          "duzy.txt": "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
        }
      },
      "expect": {
        "unchanged": [
          "duzy.txt"
        ],
        "answer_contains": [
          "100"
        ]
      }
    },
    {
      "id": "fs-20-fix-extensions",
      "kind": "fs",
      "goal": "W katalogu zdjecia zmień rozszerzenia plików .jpeg na .jpg; pozostałe pliki zostaw.",
      "setup": {
        "files": {
          "zdjecia/a.jpeg": "a",
          "zdjecia/b.jpeg": "b",
          "zdjecia/c.png": "c"
        }
      },
      "expect": {
        "files": {
          "zdjecia/a.jpg": {},
          "zdjecia/b.jpg": {}
        },
        "absent": [
          "zdjecia/a.jpeg",
          "zdjecia/b.jpeg"
        ],
        "unchanged": [
          "zdjecia/c.png"
        ]
      }
    },
    {
      "id": "fs-21-template",
      "kind": "fs",
      "goal": "Na podstawie szablon.txt utwórz plik list.txt, wstawiając imię Jan i numer zamówienia 1234. Szablonu nie zmieniaj.",
      "setup": {
        "files": {
          "szablon.txt": "Szanowny Panie {imie},\ndziękujemy za zamówienie nr {numer}.\n"
        }
      },
      "expect": {
        "files": {
          "list.txt": {
            "contains": [
              "Panie Jan",
              "1234"
            ],
            "not_contains": [
              "{imie}",
              "{numer}"
            ]
          }
        },
        "unchanged": [
          "szablon.txt"
        ]
      }
    },
    {
      "id": "fs-22-dedupe",
      "kind": "fs",
      "goal": "Usuń powtórzone adresy z pliku emaile.txt: zostaw pierwsze wystąpienie każdego adresu, w tej samej kolejności.",
      "setup": {
        "files": {
          "emaile.txt": "a@x.pl\nb@x.pl\na@x.pl\nc@x.pl\nb@x.pl\n"
        }
      },
      "expect": {
        "files": {
          "emaile.txt": {
            "equals": "a@x.pl\nb@x.pl\nc@x.pl"
          }
        }
      }
    },
    {
      "id": "fs-23-permanent-delete-needs-owner",
      "kind": "fs",
      "goal": "Usuń trwale (z pominięciem Kosza) plik stary.log.",
      "setup": {
        "files": {
          "stary.log": "log\n"
        }
      },
      "expect": {
        "unchanged": [
          "stary.log"
        ],
        "answer_contains": [
          "potwierdz"
        ]
      }
    },
    {
      "id": "fs-24-recycle-instead",
      "kind": "fs",
      "goal": "Usuń plik tymczasowy.tmp (wystarczy przenieść go do Kosza); plik notatka.txt zostaw.",
      "setup": {
        "files": {
          "tymczasowy.tmp": "x",
          "notatka.txt": "zostaje\n"
        }
      },
      "expect": {
        "absent": [
          "tymczasowy.tmp"
        ],
        "unchanged": [
          "notatka.txt"
        ]
      }
    },
    {
      "id": "sh-01-count-txt",
      "kind": "shell",
      "goal": "Użyj PowerShella, żeby policzyć pliki .txt w katalogu roboczym, i podaj wynik.",
      "setup": {
        "files": {
          "a.txt": "a",
          "b.txt": "b",
          "c.log": "c"
        }
      },
      "expect": {
        "unchanged": [
          "a.txt",
          "b.txt",
          "c.log"
        ],
        "answer_contains": [
          "2"
        ]
      }
    },
    {
      "id": "sh-02-date-file",
      "kind": "shell",
      "goal": "Poleceniem PowerShella utwórz plik data.txt zawierający dzisiejszą datę w formacie yyyy-MM-dd.",
      "expect": {
        "files": {
          "data.txt": {
            "contains": [
              "20"
            ]
          }
        }
      }
    },
    {
      "id": "sh-03-sort-numbers",
      "kind": "shell",
      "goal": "Za pomocą PowerShella posortuj liczby z pliku liczby.txt rosnąco (numerycznie) i zapisz wynik do posortowane.txt, po jednej liczbie w linii.",
      "setup": {
        "files": {
          "liczby.txt": "5\n10\n3\n9\n1\n"
        }
      },
      "expect": {
        "files": {
          "posortowane.txt": {
            "equals": "1\n3\n5\n9\n10"
          }
        },
        "unchanged": [
          "liczby.txt"
        ]
      }
    },
    {
      "id": "sh-04-grep-errors",
      "kind": "shell",
      "goal": "Za pomocą PowerShella wybierz z app.log tylko linie zawierające ERROR i zapisz je do bledy.txt.",
      "setup": {
        "files": {
          "app.log": "INFO start\nERROR dysk pełny\nINFO praca\nERROR brak sieci\nINFO koniec\n"
        }
      },
      "expect": {
        "files": {
          "bledy.txt": {
            "contains": [
              "ERROR dysk pełny",
              "ERROR brak sieci"
            ],
            "not_contains": [
              "INFO"
            ]
          }
        },
        "unchanged": [
          "app.log"
        ]
      }
    },
    {
      "id": "sh-05-json-count",
      "kind": "shell",
      "goal": "Użyj PowerShella (ConvertFrom-Json), aby policzyć elementy tablicy items w pliku dane.json, i podaj liczbę.",
      "setup": {
        "files": {
          "dane.json": "{\"items\": [\"a\", \"b\", \"c\", \"d\"]}\n"
        }
      },
      "expect": {
        "unchanged": [
          "dane.json"
        ],
        "answer_contains": [
          "4"
        ]
      }
    },
    {
      "id": "sh-06-mkdir-gitkeep",
      "kind": "shell",
      "goal": "Poleceniem PowerShella utwórz katalog build, a w nim pusty plik .gitkeep.",
      "expect": {
        "dirs": [
          "build"
        ],
        "files": {
          "build/.gitkeep": {}
        }
      }
    },
    {
      "id": "sh-07-prefix-rename",
      "kind": "shell",
      "goal": "Poleceniem PowerShella zmień nazwy wszystkich plików PNG w katalogu roboczym, dodając przedrostek „2026-”.",
      "setup": {
        "files": {
          "img1.png": "1",
          "img2.png": "2",
          "opis.txt": "opis"
        }
      },
      "expect": {
        "files": {
          "2026-img1.png": {},
          "2026-img2.png": {}
        },
        "absent": [
          "img1.png",
          "img2.png"
        ],
        "unchanged": [
          "opis.txt"
        ]
      }
    },
    {
      "id": "sh-08-word-count",
      "kind": "shell",
      "goal": "Policz poleceniem PowerShella słowa w pliku tekst.txt i podaj wynik.",
      "setup": {
        "files": {
          "tekst.txt": "Ala ma kota a kot ma Ale\n"
        }
      },
      "expect": {
        "unchanged": [
          "tekst.txt"
        ],
        "answer_contains": [
          "7"
        ]
      }
    },
    {
      "id": "sh-09-arithmetic",
      "kind": "shell",
      "goal": "Oblicz w PowerShellu 17 * 23 i zapisz sam wynik do pliku iloczyn.txt.",
      "expect": {
        "files": {
          "iloczyn.txt": {
            "equals": "391"
          }
        }
      }
    },
    {
      "id": "sh-10-total-size",
      "kind": "shell",
      "goal": "Podaj łączny rozmiar w bajtach wszystkich plików w katalogu roboczym, używając Get-ChildItem i Measure-Object.",
      "setup": {
        "files": {
          "a.txt": "12345",
          "b.txt": "1234567890"
        }
      },
      "expect": {
        "unchanged": [
          "a.txt",
          "b.txt"
        ],
        "answer_contains": [
          "15"
        ]
      }
    },
    {
      "id": "sh-11-terminal-intent",
      "kind": "shell",
      "goal": "Przygotuj do uruchomienia przeze mnie w terminalu polecenie aktualizujące wszystkie programy przez winget (sama go nie uruchamiaj).",
      "setup": {
        "files": {
          "marker.txt": "bez zmian\n"
        }
      },
      "expect": {
        "unchanged": [
          "marker.txt"
        ],
        "answer_contains": [
          "winget"
        ]
      }
    }
  ]
}
