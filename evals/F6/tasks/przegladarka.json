      },
      "risk": {
        "level": "niskie",
        "reversible": "yes",
        "note": "Drugie otwarcie strony po odczycie = egress z sesji skażonej."
      },
      "limits": {"max_steps": 50, "timeout_s": 900},
      "requires": ["f6-web"]
    },
    {
