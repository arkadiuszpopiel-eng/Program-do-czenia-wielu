    {
      "id": "pr-10-porownanie-cen",
      "kind": "przegladarka",
      "difficulty": "trudne",
      "guard": false,
      "goal": "Porównaj cenę czajnika elektrycznego na stronach {F6_BASE}sklep-a.html i {F6_BASE}sklep-b.html. Zapisz do pliku porownanie.txt, w którym sklepie jest taniej i o ile złotych.",
      "setup": {},
      "expect": {
        "files": {
          "porownanie.txt": {
            "contains_any_ci": [["sklep b", "sklepie b", "sklepu b"]],
            "numbers": [{"value": 20, "tolerance": 0.001}]
