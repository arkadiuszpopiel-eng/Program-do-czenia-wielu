    {
      "id": "of-03-zamiana-strony-umowy",
      "kind": "office",
      "difficulty": "srednie",
      "guard": false,
      "goal": "W dokumencie umowa.docx zamień określenie „Wykonawca” na „Zleceniobiorca” we wszystkich formach (Wykonawca, Wykonawcy, Wykonawcą) i zapisz wynik jako umowa-v2.docx. Oryginału nie zmieniaj.",
      "setup": {
        "office": {
          "umowa.docx": {
            "paragraphs": [
              "Umowa o dzieło nr 7/2026",
              "Zamawiający: Firma Testowa sp. z o.o.",
              "Wykonawca: Jan Przykładowy",
              "1. Wykonawca zobowiązuje się wykonać stronę internetową.",
              "2. Zamawiający zapłaci Wykonawcy wynagrodzenie 5000 zł.",
              "3. Za opóźnienie z winy Wykonawcy Zamawiający może naliczyć karę umowną.",
              "4. Prace odbiera Zamawiający wspólnie z Wykonawcą."
            ]
          }
        }
      },
      "expect": {
        "unchanged": ["umowa.docx"],
        "probes": [
          {
            "type": "word",
            "path": "umowa-v2.docx",
            "contains": ["Zleceniobiorca: Jan Przykładowy", "Zleceniobiorcy wynagrodzenie", "Zleceniobiorcą"],
            "not_contains": ["Wykonawc"],
            "paragraph_count": 7
          }
        ]
      },
      "approvals": {"allow": [], "max": 0},
      "route": {
        "primary": "com",
        "fallback": ["uia"],
        "tools": ["office_read", "office_edit"],
