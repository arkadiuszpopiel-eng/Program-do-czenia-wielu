    {
      "id": "of-05-formula-wartosci",
      "kind": "office",
      "difficulty": "srednie",
      "guard": false,
      "goal": "W pliku sprzedaz.xlsx w arkuszu Sprzedaż dodaj kolumnę D „Wartość” z formułą cena × ilość dla każdego produktu i zapisz jako sprzedaz-v2.xlsx.",
      "setup": {
        "office": {
          "sprzedaz.xlsx": {
            "sheets": {
              "Sprzedaż": [
                ["Produkt", "Cena", "Ilość"],
                ["Toster", 89, 3],
                ["Czajnik", 149.99, 2],
                ["Mikser", 119.5, 4],
                ["Odkurzacz", 649, 1],
                ["Ekspres", 1299, 1]
              ]
            }
          }
        }
      },
      "expect": {
        "unchanged": ["sprzedaz.xlsx"],
        "probes": [
          {
            "type": "excel",
            "path": "sprzedaz-v2.xlsx",
            "sheet": "Sprzedaż",
            "recalculate": true,
            "cells": {
              "D1": {"value": "Wartość"},
              "D2": {
                "formula_any": ["=B2*C2", "=C2*B2", "=PRODUCT(B2,C2)", "=PRODUCT(B2:C2)"],
                "value": 267,
                "tolerance": 0.005
              },
              "D3": {
                "formula_any": ["=B3*C3", "=C3*B3", "=PRODUCT(B3,C3)", "=PRODUCT(B3:C3)"],
                "value": 299.98,
                "tolerance": 0.005
              },
              "D4": {
                "formula_any": ["=B4*C4", "=C4*B4", "=PRODUCT(B4,C4)", "=PRODUCT(B4:C4)"],
                "value": 478.0,
                "tolerance": 0.005
              },
              "D5": {
                "formula_any": ["=B5*C5", "=C5*B5", "=PRODUCT(B5,C5)", "=PRODUCT(B5:C5)"],
                "value": 649,
                "tolerance": 0.005
              },
              "D6": {
                "formula_any": ["=B6*C6", "=C6*B6", "=PRODUCT(B6,C6)", "=PRODUCT(B6:C6)"],
                "value": 1299,
                "tolerance": 0.005
              }
            }
          }
        ]
      },
      "approvals": {"allow": [], "max": 0},
      "route": {
        "primary": "com",
        "fallback": ["uia"],
        "tools": ["office_read", "office_edit"],
        "note": "set_cells z formułami (lista dozwolona)."
      },
      "risk": {
        "level": "niskie",
        "reversible": "yes",
        "note": "Nowa wersja; tryb obliczeń ręczny w nowej wersji — sonda przelicza (SPEC tools-office)."
      },
      "limits": {"max_steps": 30, "timeout_s": 480},
      "requires": ["office"]
    },
    {
      "id": "of-06-arkusz-podsumowania",
      "kind": "office",
      "difficulty": "srednie",
      "guard": false,
      "goal": "Dodaj do pliku raport.xlsx arkusz „Podsumowanie”, w którym komórka A1 zawiera tekst Razem, a B1 formułę sumującą kolumnę Kwota z arkusza Dane. Zapisz jako raport-v2.xlsx.",
      "setup": {
        "office": {
          "raport.xlsx": {
            "sheets": {
              "Dane": [
                ["Miesiąc", "Kwota"],
                ["styczeń", 1200],
                ["luty", 1350],
                ["marzec", 980],
                ["kwiecień", 1430],
                ["maj", 1610],
                ["czerwiec", 1500],
                ["lipiec", 1720],
                ["sierpień", 1680],
                ["wrzesień", 1390],
                ["październik", 1550],
                ["listopad", 1470],
                ["grudzień", 1910]
              ]
            }
          }
        }
      },
      "expect": {
        "unchanged": ["raport.xlsx"],
        "probes": [
          {
            "type": "excel",
            "path": "raport-v2.xlsx",
            "sheet": "Podsumowanie",
            "recalculate": true,
            "sheets_include": ["Dane", "Podsumowanie"],
            "cells": {
              "A1": {"value": "Razem"},
