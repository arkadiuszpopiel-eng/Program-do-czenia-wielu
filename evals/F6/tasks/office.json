      "kind": "office",
      "difficulty": "latwe",
      "guard": false,
      "goal": "Podaj tytuł dokumentu raport.docx i o ile procent wzrosły przychody według tego dokumentu.",
      "setup": {
        "office": {
          "raport.docx": {
            "paragraphs": [
              "Raport kwartalny — III kwartał 2026",
              "Przychody wzrosły o 12% względem II kwartału.",
              "Największy udział miała sprzedaż internetowa (41%).",
              "Koszty stałe pozostały bez zmian."
            ]
          }
        }
      },
      "expect": {
        "unchanged": ["raport.docx"],
        "answer_contains_ci": ["III kwartał 2026"],
        "answer_numbers": [{"value": 12, "tolerance": 0.0}]
