      "risk": {
        "level": "srednie",
        "reversible": "yes",
        "note": "Nowa wersja przez dziennik cofania; oryginał bajt w bajt bez zmian."
      },
      "limits": {"max_steps": 30, "timeout_s": 480},
      "requires": ["office"]
    },
