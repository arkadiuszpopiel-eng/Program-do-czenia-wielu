+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore = "rzeczywisty lokalny model; syntetyczny rejestr, bez akcji komputera"]
+async fn recorded_history_facts_on_local_model() {
+    let (mut brain, sidecar, model, report_path) = custom_live_fixture();
+    let visible = first_visible::attach(&mut brain);
+    let dir = tempfile::tempdir().unwrap();
+    let paths = AppPaths::under(dir.path());
+    let mut opts = common::options(None, Arc::new(HeadlessShell::default()));
+    opts.brain = Some(brain.clone());
+    let secrets = opts.secrets.clone().unwrap();
+    let core = AppCore::build(paths.clone(), opts).await.unwrap();
+    let draft = luna_draft();
+    let dry = core.builder_dry_run(draft.clone()).await.unwrap();
+    assert!(dry.passed, "{dry:?}");
+    let luna = core.builder_save(draft, dry.hash).await.unwrap();
+    let mut events = core.subscribe_events();
+    let mut results = Vec::new();
+    for mode in ["standard", "jarvis"] {
+        core.settings_set(
+            "agents.interaction_mode".into(),
+            SettingValue::Text(mode.into()),
+        )
+        .await
+        .unwrap();
+        for agent in ["alfa", "beta", "gama", "delta", "luna"] {
+            for scenario in ["empty_record", "recorded_done", "needs_confirmation"] {
+                let sid = history_seed::seed(&core, &paths, secrets.clone(), agent, scenario).await;
+                if agent == "luna" {
+                    core.agents_set_roles(
+                        sid.clone(),
+                        luna.persona.clone(),
+                        vec![luna.role.clone()],
+                    )
+                    .await
+                    .unwrap();
+                }
+                let mut message = common::send(history_seed::QUERY, None);
+                message.addressed_to = Some(agent.into());
+                let started = Instant::now();
+                visible.start(started);
+                let turn = core
+                    .turns_send(sid.clone(), message)
+                    .await
+                    .unwrap()
+                    .assistant_turn_id
+                    .unwrap();
+                let finished = wait_for_luna(&core, &sidecar, &mut events, &sid, &turn).await;
+                assert!(finished, "{agent}/{mode}/{scenario}: przekroczone120s");
+                let turns = core.turns_list(sid).await.unwrap();
+                let answer = turns.turns.iter().find(|t| t.id == turn).unwrap();
+                let request = brain.sent.lock().unwrap().last().cloned().unwrap();
+                results.push(serde_json::json!({
+                    "agent":agent, "mode":mode, "scenario":scenario,
+                    "elapsed_ms":started.elapsed().as_millis(), "text":answer.text,
+                    "first_visible_text_ms":visible.first_ms(),
+                    "first_visible_within_60s":visible.first_ms().map(|ms| ms <= 60_000),
+                    "error":answer.error, "response_author":answer.author,
+                    "truncated":answer.truncated, "usage":answer.usage,
+                    "provider_request":request,
+                    "synthetic_prior_ledger_not_physical_execution":true
+                }));
+                let report = serde_json::json!({
+                    "model":model, "platform":"Cloud Linux CPU, forced local Brain, fake host ports",
+                    "max_tokens":96, "temperature":0.0, "query":history_seed::QUERY,
+                    "first_visible_budget_ms":60_000,
+                    "transport_success_is_not_timing_acceptance":true,
+                    "method":"three contradictory prior-text/ledger cases per persona and profile; manual semantic review separate",
+                    "results":results
+                });
+                std::fs::write(&report_path, serde_json::to_string_pretty(&report).unwrap())
+                    .unwrap();
+                assert!(answer.error.is_none(), "{:?}", answer.error);
+                assert_eq!(answer.author, agent);
+                assert!(!answer.text.trim().is_empty());
+                assert!(!answer.truncated);
+                assert!(request.tools.is_empty());
+                eprintln!(
+                    "{agent}/{mode}/{scenario}: {}ms",
+                    started.elapsed().as_millis()
+                );
+            }
+        }
+    }
+    sidecar
+        .stop("ukończona próba faktów zapisanej historii")
+        .await;
+}
