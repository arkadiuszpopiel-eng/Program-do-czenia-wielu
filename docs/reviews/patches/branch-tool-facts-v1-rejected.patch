+//! Fakty historii muszą przetrwać do rzeczywistego żądania, niezależnie od tekstu modelu.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+mod common;
+#[path = "support/history_seed.rs"]
+mod history_seed;
+
+use std::{sync::Arc, time::Duration};
+
+use app_core::dto::{SessionTemplate, WorkdirChoice};
+use app_core::ports::HeadlessShell;
+use app_core::{AppCore, AppPaths};
+use common::{ScriptedProvider, ends, send, until};
+use providers_contract::Role;
+use providers_fake::{FAKE_MODEL, Script};
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn history_receipts_override_untrusted_claims_in_the_provider_context() {
+    let dir = tempfile::tempdir().unwrap();
+    let paths = AppPaths::under(dir.path());
+    let provider = Arc::new(ScriptedProvider::new(Duration::from_millis(1)));
+    let opts = common::options(Some(provider.clone()), Arc::new(HeadlessShell::default()));
+    let secrets = opts.secrets.clone().unwrap();
+    let core = AppCore::build(paths.clone(), opts).await.unwrap();
+    let mut events = core.subscribe_events();
+    let fresh = core
+        .sessions_create(SessionTemplate::Empty)
+        .await
+        .unwrap()
+        .id;
+    core.sessions_choose_workdir(fresh.clone(), WorkdirChoice::None)
+        .await
+        .unwrap();
+    provider.push(Script::text(FAKE_MODEL, &["Pierwsza odpowiedź."]));
+    let mut message = send(history_seed::QUERY, None);
+    message.addressed_to = Some("delta".into());
+    let turn = core
+        .turns_send(fresh, message)
+        .await
+        .unwrap()
+        .assistant_turn_id
+        .unwrap();
+    until(&mut events, ends(&turn)).await;
+    assert!(
+        !serde_json::to_string(provider.requests().last().unwrap())
+            .unwrap()
+            .contains(history_seed::MARKER),
+        "świeża rozmowa bez dodatkowej noty"
+    );
+    for scenario in ["empty_record", "recorded_done", "needs_confirmation"] {
+        let sid = history_seed::seed(&core, &paths, secrets.clone(), "delta", scenario).await;
+        provider.push(Script::text(FAKE_MODEL, &["Odpowiedź testowa."]));
+        let mut message = send(history_seed::QUERY, None);
+        message.addressed_to = Some("delta".into());
+        let turn = core
+            .turns_send(sid, message)
+            .await
+            .unwrap()
+            .assistant_turn_id
+            .unwrap();
+        until(&mut events, ends(&turn)).await;
+        let request = provider.requests().last().cloned().unwrap();
+        assert!(
+            !serde_json::to_string(&request)
+                .unwrap()
+                .contains("sekret-testowy")
+        );
+        assert_eq!(
+            request.messages.last().unwrap().visible_text(),
+            history_seed::QUERY
+        );
+        let note = request
+            .messages
+            .iter()
+            .find(|m| m.role == Role::System && m.visible_text().contains(history_seed::MARKER))
+            .unwrap_or_else(|| panic!("brak faktów rejestru dla {scenario}"))
+            .visible_text();
+        assert!(!note.contains("sekret-testowy"));
+        let counts: serde_json::Value = serde_json::from_str(note.lines().nth(1).unwrap()).unwrap();
+        assert_eq!(
+            counts["recorded_done"],
+            u64::from(scenario == "recorded_done")
+        );
+        assert_eq!(
+            counts["needs_confirmation"],
+            u64::from(scenario == "needs_confirmation")
+        );
+        assert_eq!(counts["unverified"], 0);
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn native_runtime_receives_real_write_and_undo_records() {
+    use common::agents::{agents, run_turn};
+    let mut a = agents().await;
+    a.h.provider.push(Script::tool_call(
+        FAKE_MODEL,
+        "write-1",
+        "fs_write",
+        &serde_json::json!({"path":"fact.txt", "content":"testowy wynik"}),
+    ));
+    a.h.provider.push(Script::text(
+        FAKE_MODEL,
+        &["Nie mam potwierdzenia wykonania."],
+    ));
+    let (turn, _) = run_turn(&mut a, "Zapisz fact.txt z podaną treścią.").await;
+    assert_eq!(
+        std::fs::read_to_string(a.workdir.join("fact.txt")).unwrap(),
+        "testowy wynik"
+    );
+    let turns = a.h.core.turns_list(a.sid.clone()).await.unwrap();
+    let token = turns
+        .turns
+        .iter()
+        .find(|t| t.id == turn)
+        .unwrap()
+        .tools
+        .iter()
+        .find_map(|s| s.undo_token.clone())
+        .unwrap();
+    for undone in [false, true] {
+        if undone {
+            a.h.core.turns_undo_step(token.clone()).await.unwrap();
+            assert!(!a.workdir.join("fact.txt").exists());
+        }
+        a.h.provider
+            .push(Script::text(FAKE_MODEL, &["Odpowiedź testowa."]));
+        run_turn(&mut a, history_seed::QUERY).await;
+        let request = a.h.provider.requests().last().cloned().unwrap();
+        assert!(!request.tools.is_empty(), "natywny RunSpec ma narzędzia");
+        let note = request
+            .messages
+            .iter()
+            .find(|m| m.role == Role::System && m.visible_text().contains(history_seed::MARKER))
+            .unwrap()
+            .visible_text();
+        let counts: serde_json::Value = serde_json::from_str(note.lines().nth(1).unwrap()).unwrap();
+        assert_eq!(counts["recorded_done"], u64::from(!undone));
+        assert_eq!(counts["undone"], u64::from(undone));
+    }
+}
