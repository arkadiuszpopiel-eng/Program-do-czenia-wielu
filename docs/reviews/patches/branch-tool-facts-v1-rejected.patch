+//! Pasywny pomiar widocznej treści; Started, metadane, myślenie i puste delty nie zaliczają czasu.
+use super::*;
+use futures_util::StreamExt;
+use providers_contract::ProviderEvent;
+
+#[derive(Default)]
+pub struct Clock(Mutex<Option<(Instant, Option<u128>)>>);
+
+impl Clock {
+    pub fn start(&self, now: Instant) {
+        *self.0.lock().unwrap() = Some((now, None));
+    }
+    pub fn first_ms(&self) -> Option<u128> {
+        self.0
+            .lock()
+            .unwrap()
+            .as_ref()
+            .and_then(|(_, first)| *first)
+    }
+    fn observe_at(&self, event: &ProviderEvent, now: Instant) {
+        if matches!(event, ProviderEvent::TextDelta { text, .. } if !text.is_empty()) {
+            let mut state = self.0.lock().unwrap();
+            if let Some((started, first)) = state.as_mut()
+                && first.is_none()
+            {
+                *first = Some(now.duration_since(*started).as_millis());
+            }
+        }
+    }
+}
+
+struct Observed {
+    inner: Arc<dyn ModelProvider>,
+    clock: Arc<Clock>,
+}
+
+#[async_trait::async_trait]
+impl ModelProvider for Observed {
+    fn id(&self) -> &ProviderId {
+        self.inner.id()
+    }
+    fn capabilities(&self) -> ProviderCapabilities {
+        self.inner.capabilities()
+    }
+    fn health(&self) -> ProviderHealth {
+        self.inner.health()
+    }
+    fn estimate_cost(&self, request: &ChatRequest) -> Option<CostEstimate> {
+        self.inner.estimate_cost(request)
+    }
+    fn cost(&self, model: &str, usage: &Usage) -> Option<Cost> {
+        self.inner.cost(model, usage)
+    }
+    async fn list_models(&self) -> Result<Vec<ModelInfo>, ProviderError> {
+        self.inner.list_models().await
+    }
+    fn stream(&self, request: ChatRequest, cancel: CancellationToken) -> ProviderStream {
+        let clock = self.clock.clone();
+        Box::pin(self.inner.stream(request, cancel).inspect(move |e| {
+            clock.observe_at(e, Instant::now());
+        }))
+    }
+}
+
+pub fn attach(brain: &mut Arc<LocalBrain>) -> Arc<Clock> {
+    let clock = Arc::new(Clock::default());
+    let brain = Arc::get_mut(brain).unwrap();
+    brain.provider = Arc::new(Observed {
+        inner: brain.provider.clone(),
+        clock: clock.clone(),
+    });
+    clock
+}
+
+#[test]
+fn only_first_visible_text_counts_and_sixty_seconds_are_not_extended() {
+    let clock = Clock::default();
+    let start = Instant::now();
+    clock.start(start);
+    for event in [
+        ProviderEvent::Started {
+            model: "fake".into(),
+            response_id: None,
+        },
+        ProviderEvent::ThinkingDelta {
+            index: 0,
+            text: "wewnętrzne".into(),
+        },
+        ProviderEvent::Usage(Usage::default()),
+        ProviderEvent::TextDelta {
+            index: 0,
+            text: String::new(),
+        },
+    ] {
+        clock.observe_at(&event, start + Duration::from_secs(1));
+        assert!(clock.first_ms().is_none());
+    }
+    let content = ProviderEvent::TextDelta {
+        index: 0,
+        text: "Wynik".into(),
+    };
+    clock.observe_at(&content, start + Duration::from_millis(60_001));
+    clock.observe_at(&content, start + Duration::from_secs(70));
+    assert_eq!(clock.first_ms(), Some(60_001));
+    assert!(clock.first_ms().is_none_or(|ms| ms > 60_000));
+}
