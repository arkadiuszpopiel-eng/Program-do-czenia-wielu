+//! Host przekazuje fakty wybranej gałęzi także modelowi odpowiadającemu bez narzędzi.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+mod common;
+
+use app_core::dto::{SessionTemplate, WorkdirChoice};
+use common::{ends, harness_with, send, until};
+use providers_fake::{FAKE_MODEL, Script};
+use std::time::Duration;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn plain_reply_receives_recorded_tool_facts_before_first_action() {
+    let mut h = harness_with(Duration::from_millis(1), true).await;
+    let sid = h
+        .core
+        .sessions_create(SessionTemplate::Empty)
+        .await
+        .unwrap()
+        .id;
+    h.core
+        .sessions_choose_workdir(sid.clone(), WorkdirChoice::None)
+        .await
+        .unwrap();
+    h.provider.push(Script::text(
+        FAKE_MODEL,
+        &["Nie mam potwierdzenia wykonania."],
+    ));
+    let result = h
+        .core
+        .turns_send(sid, send("Czy już sprawdziłaś pliki?", None))
+        .await
+        .unwrap();
+    until(&mut h.rx, ends(&result.assistant_turn_id.unwrap())).await;
+    let request = h.provider.requests().last().cloned().unwrap();
+    assert!(request.tools.is_empty());
+    let system = request.system.unwrap();
+    assert!(system.contains("[Zarejestrowane narzędzia wybranej gałęzi]"));
+    assert!(system.contains("\"recorded_done\":0"));
+    assert!(system.contains("\"needs_confirmation\":0"));
+    assert!(system.contains("\"unverified\":0"));
+}
