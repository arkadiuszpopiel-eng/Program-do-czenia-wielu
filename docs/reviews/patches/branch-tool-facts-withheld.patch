index 00000000..a3f2394d
--- /dev/null
+++ b/crates/app-chat/src/tool_facts.rs
@@ -0,0 +1,51 @@
+//! Ograniczone fakty zapisów wybranej gałęzi, bez etykiet, poleceń i wyjścia narzędzi.
+use std::collections::{BTreeMap, BTreeSet};
+
+use app_api::{AppError, dto::ToolStatus};
+use app_store::TurnMeta;
+use serde::Serialize;
+
+#[derive(Default, Serialize)]
+struct Facts {
+    recorded_done: usize,
+    needs_confirmation: usize,
+    error_or_denied: usize,
+    recorded_running: usize,
+    undone: usize,
+    unverified: usize,
+}
+
+pub(crate) fn note(
+    turns: impl IntoIterator<Item = u64>,
+    metas: &BTreeMap<u64, TurnMeta>,
+    undone: &BTreeSet<String>,
+) -> Result<String, AppError> {
+    let mut facts = Facts::default();
+    for id in turns {
+        let Some(meta) = metas.get(&id) else {
+            facts.unverified += 1;
+            continue;
+        };
+        for step in &meta.tools {
+            if step.undone || step.undo_token.as_ref().is_some_and(|t| undone.contains(t)) {
+                facts.undone += 1;
+                continue;
+            }
+            match step.status {
+                ToolStatus::Done if step.intent.is_some() => facts.unverified += 1,
+                ToolStatus::Done => facts.recorded_done += 1,
+                ToolStatus::NeedsConfirmation => facts.needs_confirmation += 1,
+                ToolStatus::Error => facts.error_or_denied += 1,
+                ToolStatus::Running => facts.recorded_running += 1,
+            }
+        }
+    }
+    let json = serde_json::to_string(&facts).map_err(|e| AppError::internal(e.to_string()))?;
+    Ok(format!(
+        "[Zarejestrowane narzędzia wybranej gałęzi]\n{json}\nRejestr dotyczy historii sprzed tej odpowiedzi. Nowe wyniki narzędzi bieżącej tury rozpatruj osobno. Nie potwierdzaj wykonania bez zapisu i wyniku narzędzia. Propozycja, błąd lub cofnięcie nie są sukcesem. Sam zapis done nie dowodzi zaliczonych testów. Brak zapisu oznacza brak potwierdzenia w rejestrze, nie brak uprawnień; nie rozstrzyga działań poza nim."
+    ))
+}
+
+#[cfg(test)]
+#[path = "../tests/support/tool_facts.rs"]
+mod tests;
