+fn owned_server_ping_has_margin_before_the_default_client_idle_deadline() {
+    let config = LocalConfig::new("/m", "/bin/llama-server");
+    assert_eq!(
+        config.timeouts.first_token,
+        std::time::Duration::from_secs(60)
