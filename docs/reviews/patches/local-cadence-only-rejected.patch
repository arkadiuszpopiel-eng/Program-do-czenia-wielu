+            ctx: 8192,
+            threads: 4,
+            device: None,
+        };
+        for entry in builtin_models().unwrap() {
+            let args = plan.args(&entry, std::path::Path::new("/m/x.gguf"), 4321, "test");
+            let seconds: u64 = support::arg(&args, "--sse-ping-interval")
+                .expect("jawny ping serwera zamiast domyślnych30s na granicy idle")
+                .parse()
+                .unwrap();
+            assert!(seconds > 0);
+            assert!(std::time::Duration::from_secs(seconds * 3) <= config.timeouts.idle);
+        }
+    }
+}
