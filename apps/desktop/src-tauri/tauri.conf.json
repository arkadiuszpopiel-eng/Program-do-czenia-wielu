{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alfa",
  "version": "0.0.1",
  "identifier": "pl.alfa.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @alfa/desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter @alfa/desktop-ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Alfa",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": null,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
