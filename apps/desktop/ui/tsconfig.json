{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "e2e-app/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.app.config.ts",
    "svelte.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
